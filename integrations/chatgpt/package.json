{
  "name": "@visdelta/chatgpt-mcp-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/widget.js --bundle --format=esm --platform=browser --loader:.css=text --outfile=dist/widget.js",
    "start": "npm run build && node server.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build && node --test test/widget.browser.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "visdelta": "0.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2"
  }
}
