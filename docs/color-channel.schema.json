{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisDelta explicit color channel authoring subset",
  "description": "Tool authoring subset for encoding.color, checked against the 0.4.2 checkout. Not a complete ViewSpec schema or chart/data validator. Do not combine value and field. Built-in edit adapters accept one string or explicit channel object; this schema describes the object subset.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "CSS color literal, e.g. red or #4269d0"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "field",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "nominal",
            "ordinal"
          ]
        },
        "scheme": {
          "type": "string",
          "examples": [
            "Tableau10",
            "Viridis"
          ]
        },
        "domain": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "range": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "not": {
        "required": [
          "range",
          "scheme"
        ]
      }
    },
    {
      "type": "object",
      "required": [
        "field",
        "type",
        "scheme"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "quantitative"
        },
        "scheme": {
          "type": "string",
          "examples": [
            "Viridis"
          ]
        },
        "domain": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    }
  ]
}
